{% extends '@View/Layout/AuthenticationLayout.html.twig' %}

{% block head_extra %}
    <script>
        function goBack() {
            window.history.back();
        }
    </script>
{% endblock %}

{% block body %}
    <div class="container">
        <div class="row mt-5">
            <div class="col-sm-8"><h1>{{ title }}</h1></div>
        </div>
        <p>{{ message }}</p>
        <button type="button" onclick="goBack()" class="btn btn-outline-success my-2 my-sm-0">
            <span class="fa fa-angle-left"></span> Ga terug
        </button>
    </div>
{% endblock %}
