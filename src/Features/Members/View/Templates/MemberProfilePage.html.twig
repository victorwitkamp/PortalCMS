{% extends '@View/Layout/ApplicationLayout.html.twig' %}

{% set pageName = 'Lidmaatschap van ' ~ member.voornaam ~ ' ' ~ member.achternaam %}

{% macro boolean(value) %}{{ value is same as(true) ? 'ja' : (value is same as(false) ? 'nee' : 'n/a') }}{% endmacro %}
{% import _self as display %}

{% block title %}{{ pageName }}{% endblock %}

{% block main_content %}
    <div class="container">
        <div class="row mt-5"><h1>{{ pageName }}</h1></div>
        <form method="post" action="{{ path('members.delete') }}">
            <a href="{{ path('members.index') }}" class="btn btn-sm btn-primary"><span class="fa fa-arrow-left"></span></a>
            <a href="{{ path('members.edit', {Id: member.id}) }}" class="btn btn-sm btn-warning"><span class="fa fa-edit"></span></a>
            <input name="id" type="hidden" value="{{ member.id }}">
            <input name="_csrf_token" type="hidden" value="{{ csrf_token('members.delete') }}">
            <button type="submit" onclick="return confirm('Weet je zeker dat je dit lidmaatschap wilt verwijderen?')"
                    class="btn btn-sm btn-danger"><i class="far fa-trash-alt"></i></button>
        </form>
        <hr>
        <div class="row">
            <div class="col-md-8">
                <table class="table table-striped table-condensed">
                    <tr><th>ID</th><td>{{ member.id }}</td></tr>
                    <tr><th>Jaar van lidmaatschap</th><td>{{ member.jaarlidmaatschap }}</td></tr>
                    <tr><th>Voorletters</th><td>{{ member.voorletters }}</td></tr>
                    <tr><th>Voornaam</th><td>{{ member.voornaam }}</td></tr>
                    <tr><th>Achternaam</th><td>{{ member.achternaam }}</td></tr>
                    <tr><th>Geboortedatum</th><td>{{ member.geboortedatum }}</td></tr>
                    <tr><th>Adres</th><td>{{ member.adres }}</td></tr>
                    <tr><th>Postcode</th><td>{{ member.postcode }}</td></tr>
                    <tr><th>Huisnummer</th><td>{{ member.huisnummer }}</td></tr>
                    <tr><th>Woonplaats</th><td>{{ member.woonplaats }}</td></tr>
                    <tr><th>Telefoon vast</th><td>{{ member.telefoon_vast }}</td></tr>
                    <tr><th>Telefoon mobiel</th><td>{{ member.telefoon_mobiel }}</td></tr>
                    <tr><th>E-mailadres</th><td>{{ member.emailadres }}</td></tr>
                    <tr><th>Lid vanaf</th><td>{{ member.ingangsdatum }}</td></tr>
                </table>
            </div>
            <div class="col-md-4">
                <table class="table table-striped table-condensed">
                    <tr><th>Geslacht</th><td>{{ member.geslacht }}</td></tr>
                    <tr><th>Nieuwsbrief</th><td>{{ display.boolean(member.nieuwsbrief) }}</td></tr>
                    <tr><th>Vrijwilliger</th><td>{{ display.boolean(member.vrijwilliger) }}</td></tr>
                    <tr><th>Licht / geluid</th><td>{{ display.boolean(member.vrijwilligeroptie1) }}</td></tr>
                    <tr><th>Bar</th><td>{{ display.boolean(member.vrijwilligeroptie2) }}</td></tr>
                    <tr><th>Schoonmaken / klussen</th><td>{{ display.boolean(member.vrijwilligeroptie3) }}</td></tr>
                    <tr><th>Promotie / flyeren</th><td>{{ display.boolean(member.vrijwilligeroptie4) }}</td></tr>
                    <tr><th>Organisatie evenementen</th><td>{{ display.boolean(member.vrijwilligeroptie5) }}</td></tr>
                </table>
                <table class="table table-striped table-condensed">
                    <tr><th>CreationDate</th><td>{{ member.creationDate }}</td></tr>
                    <tr><th>ModificationDate</th><td>{{ member.modificationDate }}</td></tr>
                </table>
            </div>
            <table class="table table-striped table-condensed">
                <tr><th>Betalingswijze</th><td>{{ member.betalingswijze }}</td></tr>
                <tr><th>IBAN</th><td>{{ member.iban }}</td></tr>
                <tr><th>Machtigingskenmerk</th><td>{{ member.machtigingskenmerk }}</td></tr>
                <tr><th>Status</th><td>{{ member.status }}</td></tr>
                <tr><th>Opmerking</th><td>{{ member.opmerking }}</td></tr>
            </table>
        </div>
    </div>
{% endblock %}
