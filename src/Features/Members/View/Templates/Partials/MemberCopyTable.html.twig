{% set statusLabels = {
    0: '0. Nieuw',
    1: '1. Incasso opdracht verzonden',
    11: '1.1 Niet verstuurd: rekeningnummer onjuist',
    2: '2. Betaling per incasso gelukt',
    21: '2.1 Incasso mislukt: rekeningnummer onjuist',
    3: '3',
    4: '4'
} %}

<form method="post" action="{{ path('members.copy') }}">
    <label for="target-year">Doeljaar</label>
    <input type="number" id="target-year" class="form-control" name="targetYear" min="1900" max="2100" required>
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('members.copy') }}">
    <input type="submit" class="btn btn-danger" value="copyMembersById">
    <table id="example" class="table table-sm table-striped table-hover table-dark" style="width:100%;">
        <thead class="table-dark">
        <tr><th class="text-center"><input type="checkbox" id="selectall"></th><th>Naam</th><th>Betalingswijze</th><th>Status</th></tr>
        </thead>
        <tbody>
        {% for member in members %}
            <tr>
                <td class="text-center"><input type="checkbox" name="id[]" id="checkbox{{ member.id }}" value="{{ member.id }}"></td>
                <td>{{ member.voornaam }} {{ member.achternaam }}</td>
                <td>{{ member.betalingswijze }}</td>
                <td>{{ statusLabels[member.status]|default(member.status) }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</form>
<script>
    document.getElementById('selectall').addEventListener('change', function () {
        document.querySelectorAll("input[type='checkbox']").forEach(checkbox => {
            checkbox.checked = this.checked;
        });
    });
</script>
