{% set edit = pageType == 'edit' %}
{% set current = member|default(null) %}
{% set routeName = edit ? 'members.update' : 'members.create' %}

{% macro value(current, name) %}{{ current ? attribute(current, name) : '' }}{% endmacro %}
{% macro selected(current, name, value) %}{{ current and attribute(current, name) is same as(value) ? ' selected' : '' }}{% endmacro %}
{% import _self as memberForm %}

<form method="post" action="{{ path(routeName) }}">
    <div class="row">
        <div class="col-md-8">
            <div class="mb-3 row">
                <div class="col-md-4">
                    <label for="member-year" class="col-form-label">Jaar van lidmaatschap</label>
                    <input type="number" id="member-year" min="1900" max="2100" name="jaarlidmaatschap"
                           class="form-control" value="{{ memberForm.value(current, 'jaarlidmaatschap') }}">
                </div>
            </div>
            <div class="mb-3 row">
                <div class="col-md-3">
                    <label for="member-initials" class="col-form-label">Voorletters</label>
                    <input type="text" id="member-initials" name="voorletters" value="{{ memberForm.value(current, 'voorletters') }}" class="form-control">
                </div>
                <div class="col-md-4">
                    <label for="member-first-name" class="col-form-label">Voornaam</label>
                    <input type="text" id="member-first-name" name="voornaam" value="{{ memberForm.value(current, 'voornaam') }}"
                           class="form-control" autocomplete="given-name">
                </div>
                <div class="col-md-5">
                    <label for="member-last-name" class="col-form-label">Achternaam</label>
                    <input type="text" id="member-last-name" name="achternaam" value="{{ memberForm.value(current, 'achternaam') }}"
                           class="form-control" autocomplete="family-name">
                </div>
            </div>
            <div class="mb-3 row">
                <div class="col-md-12">
                    <label for="member-birth-date" class="col-form-label">Geboortedatum</label>
                    <div class="input-group">
                        <div class="input-group-text"><i class="fa fa-calendar"></i></div>
                        <input type="date" id="member-birth-date" name="geboortedatum"
                               value="{{ current and current.geboortedatum ? current.geboortedatum|date('Y-m-d') : '' }}" class="form-control">
                    </div>
                </div>
            </div>
            <div class="mb-3 row">
                <div class="col-md-9">
                    <label for="member-address" class="col-form-label">Adres</label>
                    <input type="text" id="member-address" name="adres" value="{{ memberForm.value(current, 'adres') }}"
                           class="form-control" placeholder="Voorbeeldadres 123" autocomplete="street-address">
                </div>
                <div class="col-md-3">
                    <label for="member-house-number" class="col-form-label">Huisnummer</label>
                    <input type="text" id="member-house-number" name="huisnummer" value="{{ memberForm.value(current, 'huisnummer') }}"
                           class="form-control" maxlength="6" placeholder="123">
                </div>
            </div>
            <div class="mb-3 row">
                <div class="col-md-5">
                    <label for="member-postcode" class="col-form-label">Postcode</label>
                    <input type="text" id="member-postcode" name="postcode" value="{{ memberForm.value(current, 'postcode') }}"
                           class="form-control" minlength="6" maxlength="6" placeholder="1234AB" autocomplete="postal-code">
                </div>
                <div class="col-md-7">
                    <label for="member-city" class="col-form-label">Woonplaats</label>
                    <input type="text" id="member-city" name="woonplaats" value="{{ memberForm.value(current, 'woonplaats') }}"
                           class="form-control" placeholder="Barendrecht" autocomplete="address-level2">
                </div>
            </div>
            <div class="mb-3 row">
                <div class="col-md-6">
                    <label for="member-phone" class="col-form-label">Telefoon vast</label>
                    <input type="tel" id="member-phone" name="telefoon_vast" value="{{ memberForm.value(current, 'telefoon_vast') }}"
                           class="form-control" autocomplete="tel">
                </div>
                <div class="col-md-6">
                    <label for="member-mobile" class="col-form-label">Telefoon mobiel</label>
                    <input type="tel" id="member-mobile" name="telefoon_mobiel" value="{{ memberForm.value(current, 'telefoon_mobiel') }}"
                           class="form-control" autocomplete="tel">
                </div>
            </div>
            <div class="mb-3 row">
                <div class="col-md-12">
                    <label for="member-email" class="col-form-label">Emailadres</label>
                    <div class="input-group">
                        <div class="input-group-text">@</div>
                        <input type="email" id="member-email" name="emailadres" value="{{ memberForm.value(current, 'emailadres') }}"
                               class="form-control" autocomplete="email">
                    </div>
                </div>
            </div>
            <div class="mb-3 row">
                <div class="col-md-12">
                    <label for="member-start-date" class="col-form-label">Lid vanaf</label>
                    <div class="input-group">
                        <div class="input-group-text"><i class="fa fa-calendar"></i></div>
                        <input type="date" id="member-start-date" name="ingangsdatum"
                               value="{{ current and current.ingangsdatum ? current.ingangsdatum|date('Y-m-d') : '' }}" class="form-control">
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="mb-3">
                <label for="member-gender" class="col-form-label">Geslacht</label>
                <select id="member-gender" name="geslacht" class="form-control">
                    <option></option>
                    {% for value, label in {'Man': 'Man', 'Vrouw': 'Vrouw', 'nvt': 'N.v.t.'} %}
                        <option value="{{ value }}"{{ current and current.geslacht == value ? ' selected' : '' }}>{{ label }}</option>
                    {% endfor %}
                </select>
                <label for="member-newsletter" class="col-form-label">Nieuwsbrief ontvangen?</label>
                <select id="member-newsletter" name="nieuwsbrief" class="form-control">
                    <option></option>
                    <option value="1"{{ memberForm.selected(current, 'nieuwsbrief', true) }}>Ja</option>
                    <option value="0"{{ memberForm.selected(current, 'nieuwsbrief', false) }}>Nee</option>
                </select>
            </div>
            <div class="card">
                <div class="card-header"><p class="card-title">Zou je vrijwilliger willen zijn?</p></div>
                <div class="card-body">
                    <select name="vrijwilliger" class="form-control">
                        <option></option>
                        <option value="1"{{ memberForm.selected(current, 'vrijwilliger', true) }}>Ja</option>
                        <option value="0"{{ memberForm.selected(current, 'vrijwilliger', false) }}>Nee</option>
                    </select>
                </div>
            </div>
            <div class="card">
                <div class="card-header"><p class="card-title">Waar wil je ingezet worden?</p></div>
                <div class="card-body">
                    {% for field, label in {
                        vrijwilligeroptie1: 'Licht / geluid',
                        vrijwilligeroptie2: 'Bar',
                        vrijwilligeroptie3: 'Schoonmaken / klussen',
                        vrijwilligeroptie4: 'Promotie / flyeren',
                        vrijwilligeroptie5: 'Organisatie evenementen'
                    } %}
                        <label class="col-form-label">{{ label }}</label>
                        <select name="{{ field }}" class="form-control">
                            <option></option>
                            <option value="1"{{ memberForm.selected(current, field, true) }}>Ja</option>
                            <option value="0"{{ memberForm.selected(current, field, false) }}>Nee</option>
                        </select>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
    <hr>
    <div class="row">
        <div class="col-md-12">
            <label for="member-payment" class="col-form-label">Betalingswijze</label>
            <select id="member-payment" name="betalingswijze" class="form-control">
                <option></option>
                {% for value, label in {
                    contant: 'Contant',
                    pin: 'Pin',
                    incasso: 'Automatische incasso',
                    gratisbestuur: 'Gratis (bestuur)'
                } %}
                    <option value="{{ value }}"{{ current and current.betalingswijze == value ? ' selected' : '' }}>{{ label }}</option>
                {% endfor %}
            </select>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <label for="member-iban" class="col-form-label">Rekeningnummer (IBAN)</label>
            <input type="text" id="member-iban" name="iban" value="{{ memberForm.value(current, 'iban') }}" class="form-control">
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <label for="member-mandate" class="col-form-label">Machtigingskenmerk</label>
            <input type="text" id="member-mandate" name="machtigingskenmerk"
                   value="{{ memberForm.value(current, 'machtigingskenmerk') }}" class="form-control">
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <label for="member-status" class="col-form-label">Status</label>
            <select id="member-status" name="status" class="form-control">
                {% for value, label in {
                    0: '0. Nieuw',
                    1: '1. Incasso opdracht verzonden',
                    11: '1.1 Niet verstuurd: rekeningnummer onjuist',
                    2: '2. Betaling per incasso gelukt',
                    21: '2.1 Incasso mislukt: rekeningnummer onjuist',
                    3: '3',
                    4: '4'
                } %}
                    <option value="{{ value }}"{{ current and current.status == value ? ' selected' : '' }}>{{ label }}</option>
                {% endfor %}
            </select>
        </div>
    </div>
    <hr>
    <input type="hidden" name="id" value="{{ current ? current.id : '' }}">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token(routeName) }}">
    <input type="submit" class="btn btn-sm btn-primary" value="Opslaan">
    <a href="{{ path('members.index') }}" class="btn btn-sm btn-danger">Annuleren</a>
</form>
