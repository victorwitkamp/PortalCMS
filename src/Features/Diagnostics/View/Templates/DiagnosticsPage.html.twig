{% extends '@View/Layout/ApplicationLayout.html.twig' %}

{% set title = text('TITLE_DEBUG') %}

{% block main_content %}
    <div class="container">
        <div class="row mt-5"><div class="col-sm-12"><h1>{{ title }}</h1></div></div>
        {% include '@View/Partials/FlashMessages.html.twig' %}
        <hr>
        <h2>Session context</h2>
        <pre>{{ sessionContext|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
        <br>
        <h2>Temporary directory</h2>
        <p>{{ temporaryDirectory }}</p>
    </div>
{% endblock %}
