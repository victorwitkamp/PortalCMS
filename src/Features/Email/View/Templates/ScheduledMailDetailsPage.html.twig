{% extends '@View/Layout/ApplicationLayout.html.twig' %}

{% set pageName = text('TITLE_MAIL_DETAILS') %}

{% macro recipients(items) %}
    {% for recipient in items %}
        {{ recipient.name ? recipient.name ~ ' - ' : '' }}{{ recipient.email }}<br>
    {% endfor %}
{% endmacro %}
{% import _self as display %}

{% block title %}{{ pageName }}{% endblock %}

{% block main_content %}
    <div class="container">
        <div class="row mt-5"><h1>{{ pageName }}</h1></div>
        {% include '@View/Partials/FlashMessages.html.twig' %}
        <div class="row">
            <div class="col-8">
                <table class="table table-striped table-condensed">
                    <tr><th>{{ text('LABEL_MAILDETAILS_ID') }}</th><td>{{ mail.id }}</td></tr>
                    <tr><th>{{ text('LABEL_MAILDETAILS_RECIPIENT_TO') }}</th><td>{{ display.recipients(mail.recipientsOfType(1)) }}</td></tr>
                    <tr><th>{{ text('LABEL_MAILDETAILS_RECIPIENT_CC') }}</th><td>{{ display.recipients(mail.recipientsOfType(2)) }}</td></tr>
                    <tr><th>{{ text('LABEL_MAILDETAILS_RECIPIENT_BCC') }}</th><td>{{ display.recipients(mail.recipientsOfType(3)) }}</td></tr>
                    <tr><th>{{ text('LABEL_MAILDETAILS_SUBJECT') }}</th><td>{{ mail.subject }}</td></tr>
                    <tr><th>{{ text('LABEL_MAILDETAILS_BODY') }}</th><td>{{ mail.body|raw }}</td></tr>
                    <tr>
                        <th>{{ text('LABEL_MAILDETAILS_ATTACHMENTS') }}</th>
                        <td>
                            {% set attachments = mail.attachments %}
                            {% if attachments.empty %}
                                n/a
                            {% else %}
                                {% for attachment in attachments %}
                                    {% set extension = attachment.extension ? '.' ~ attachment.extension|trim('.') : '' %}
                                    {% set file = attachment.path ~ attachment.name ~ extension %}
                                    <a href="/{{ file|trim('/') }}">{{ file }}</a><br>
                                {% endfor %}
                            {% endif %}
                        </td>
                    </tr>
                    <tr><th>{{ text('LABEL_MAILDETAILS_MEMBER_ID') }}</th><td>{{ mail.member_id }}</td></tr>
                    <tr><th>{{ text('LABEL_MAILDETAILS_USER_ID') }}</th><td>{{ mail.user_id }}</td></tr>
                </table>
            </div>
            <div class="col-4">
                <table class="table table-striped table-condensed">
                    <tr><th>{{ text('LABEL_MAILDETAILS_SENDER') }}</th><td>{{ mail.sender_email }}</td></tr>
                    <tr><th>{{ text('LABEL_MAILDETAILS_DATE_SENT') }}</th><td>{{ mail.DateSent ? mail.DateSent|date('Y-m-d H:i:s') : '' }}</td></tr>
                    <tr><th>{{ text('LABEL_MAILDETAILS_STATUS') }}</th><td>{{ mail.status }}</td></tr>
                    <tr><th>{{ text('LABEL_MAILDETAILS_ERROR') }}</th><td>{{ mail.errormessage }}</td></tr>
                    <tr><th>{{ text('LABEL_MAILDETAILS_DATE_CREATION') }}</th><td>{{ mail.CreationDate|date('Y-m-d H:i:s') }}</td></tr>
                    <tr><th>{{ text('LABEL_MAILDETAILS_DATE_MODIFICATION') }}</th><td>{{ mail.ModificationDate ? mail.ModificationDate|date('Y-m-d H:i:s') : '' }}</td></tr>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
