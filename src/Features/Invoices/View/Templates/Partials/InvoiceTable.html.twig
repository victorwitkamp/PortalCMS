<form method="post">
    <div class="d-flex flex-wrap align-items-center gap-3 mb-2 p-2 bg-body-tertiary rounded">
        <div class="form-check mb-0">
            <input type="checkbox" class="form-check-input" id="selectall">
            <label class="form-check-label" for="selectall">Selecteer alles</label>
        </div>
        <button type="submit" formaction="{{ path('invoices.write') }}" name="_csrf_token"
                value="{{ csrf_token('invoices.write') }}" class="btn btn-success btn-sm" title="Maak definitief">
            <i class="fas fa-check"></i> Maak definitief
        </button>
        <button type="submit" formaction="{{ path('invoices.schedule_mail') }}" name="_csrf_token"
                value="{{ csrf_token('invoices.schedule_mail') }}" class="btn btn-success btn-sm" title="Batch inplannen">
            <i class="fas fa-paper-plane"></i> Batch inplannen
        </button>
    </div>
    <table id="example" class="table table-sm table-striped table-hover table-dark" style="width:100%;">
        <thead class="table-dark">
        <tr><th></th><th>Factuurnummer</th><th>Huurder</th><th>Bedrag</th><th>Bekijken</th><th>DateSent</th><th>Acties</th></tr>
        </thead>
        <tbody>
        {% for invoice in invoices %}
            <tr>
                <td>
                    {% if invoice.status == 0 %}
                        <input type="checkbox" class="form-check-input row-select" id="writeInvoice{{ invoice.id }}"
                               name="writeInvoiceId[]" value="{{ invoice.id }}">
                    {% elseif invoice.status == 1 %}
                        <input type="checkbox" class="form-check-input row-select" id="sendcheckbox{{ invoice.id }}"
                               name="id[]" value="{{ invoice.id }}">
                    {% endif %}
                </td>
                <td>{{ invoice.factuurnummer }}</td>
                <td>{{ invoice.contract ? invoice.contract.band_naam : '' }}</td>
                <td>&euro; {{ invoice.total }}</td>
                <td>
                    {% if invoice.status == 2 %}
                        <a href="{{ path('email.details', {id: invoice.mail_id}) }}">Mail openen</a>
                    {% endif %}
                </td>
                <td>{{ mailDates[invoice.id]|default(null) ? mailDates[invoice.id]|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('invoices.details', {id: invoice.id}) }}" title="Details" class="btn btn-primary">
                        <span class="fas fa-edit"></span>
                    </a>
                    <a href="{{ path('invoices.pdf', {id: invoice.id}) }}" title="PDF maken" class="btn btn-success">
                        <span class="fas fa-file-pdf"></span>
                    </a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</form>
<script>
    document.getElementById('selectall').addEventListener('change', function () {
        document.querySelectorAll('.row-select').forEach(checkbox => {
            checkbox.checked = this.checked;
        });
    });
</script>
