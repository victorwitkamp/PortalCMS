{% extends '@View/Layout/ApplicationLayout.html.twig' %}

{% set pageName = 'Factuur: ' ~ invoice.factuurnummer %}

{% block title %}{{ pageName }}{% endblock %}

{% block main_content %}
    <div class="container">
        <div class="row mt-5"><h1>{{ pageName }}</h1></div>
        <form method="post" action="{{ path('invoices.delete') }}">
            <a href="{{ path('invoices.index') }}" class="btn btn-sm btn-primary"><span class="fa fa-arrow-left"></span></a>
            <input type="hidden" name="id" value="{{ invoice.id }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('invoices.delete') }}">
            <button type="submit" class="btn btn-danger btn-sm" title="Verwijderen"
                    onclick="return confirm('Weet u zeker dat u deze factuur wilt verwijderen?')">
                <span class="fa fa-trash"></span>
            </button>
        </form>
        <hr>
        {% include '@View/Partials/FlashMessages.html.twig' %}
        <h3>Details</h3>
        <table class="table table-striped table-condensed">
            <tr><th>Factuurnummer</th><td>{{ invoice.factuurnummer }}</td></tr>
            <tr><th>Huurder</th><td>{{ contract.band_naam }}</td></tr>
            <tr><th>CreationDate</th><td>{{ invoice.CreationDate|date('Y-m-d H:i:s') }}</td></tr>
            <tr><th>Factuurdatum</th><td>{{ invoice.factuurdatum|date('Y-m-d') }}</td></tr>
            <tr><th>Vervaldatum</th><td>{{ invoice.vervaldatum ? invoice.vervaldatum|date('Y-m-d') : '' }}</td></tr>
        </table>
        <h3>Items</h3>
        <table class="table table-striped table-condensed">
            <tr><th>Acties</th><th>Omschrijving</th><th>Prijs</th></tr>
            {% for invoiceitem in invoice.items %}
                <tr>
                    <td>
                        {% if invoice.status == 0 %}
                            <form method="post" action="{{ path('invoices.item_delete') }}">
                                <input type="hidden" name="invoiceid" value="{{ invoice.id }}">
                                <input type="hidden" name="id" value="{{ invoiceitem.id }}">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('invoices.item_delete') }}">
                                <button type="submit" onclick="return confirm('Weet je zeker dat je dit item wilt verwijderen?')"
                                        class="btn btn-sm btn-danger"><span class="fa fa-trash"></span></button>
                            </form>
                        {% endif %}
                    </td>
                    <td>{{ invoiceitem.name }}</td>
                    <td>&euro; {{ invoiceitem.price }}</td>
                </tr>
            {% endfor %}
        </table>
        <h3>Items toevoegen</h3>
        {% if invoice.status == 0 %}
            <form method="post" action="{{ path('invoices.item_add') }}">
                <div class="row">
                    <div class="mb-3 col-md-6">
                        <label for="item-name">Omschrijving</label>
                        <input type="text" id="item-name" name="name" class="form-control">
                    </div>
                    <div class="mb-3 col-md-6">
                        <label for="item-price">Prijs</label>
                        <input type="text" id="item-price" name="price" class="form-control">
                    </div>
                </div>
                <input type="hidden" name="invoiceid" value="{{ invoice.id }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('invoices.item_add') }}">
                <button type="submit" class="btn btn-primary">Toevoegen</button>
            </form>
        {% else %}
            <p>Je kunt de factuur niet meer bewerken</p>
        {% endif %}
    </div>
{% endblock %}
