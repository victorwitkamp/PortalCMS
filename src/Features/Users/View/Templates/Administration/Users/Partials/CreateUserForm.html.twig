<form method="post" action="{{ path('users.admin_create') }}">
    <div class="row">
        <div class="col-md-12">
            <div class="mb-3">
                <h3>{{ text('LABEL_ACCOUNT_DETAILS') }}</h3>
                <div class="row">
                    <div class="col-md-12">
                        <label for="UserName" class="control-label">{{ text('LABEL_USER_NAME') }}</label>
                        <input type="text" id="UserName" name="user_name" class="form-control" required>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <label for="UserEmail" class="control-label">{{ text('LABEL_USER_EMAIL') }}</label>
                        <input type="email" id="UserEmail" name="user_email" class="form-control" required>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <label for="UserPassword" class="control-label">{{ text('LABEL_USER_PASSWORD') }}</label>
                        <input type="password" id="UserPassword" name="user_password" class="form-control" required>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('users.admin_create') }}">
    <div class="row">
        <button type="submit" class="btn btn-primary">{{ text('LABEL_SUBMIT') }}</button>
        <a href="{{ path('users.admin_users') }}" class="btn btn-danger">{{ text('LABEL_CANCEL') }}</a>
    </div>
</form>
