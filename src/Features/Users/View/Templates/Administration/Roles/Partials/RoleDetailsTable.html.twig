<h3>{{ text('LABEL_ROLE_GENERAL') }}</h3>
<table class="table table-striped table-condensed">
    <tbody>
    <tr><th>ID</th><td>{{ role.role_id }}</td></tr>
    <tr><th>Naam</th><td>{{ role.role_name }}</td></tr>
    <tr>
        <th>{{ text('LABEL_ROLE_PERMISSIONS') }}</th>
        <td>
            {% if activePermissions %}
                <table class="table table-sm table-striped table-hover table-dark">
                    <thead class="table-dark"><tr><th>ID</th><th>Permissie</th><th>Acties</th></tr></thead>
                    <tbody>
                    {% for permission in activePermissions %}
                        <tr>
                            <td>{{ permission.perm_id }}</td>
                            <td>{{ permission.perm_desc }}</td>
                            <td>
                                <form method="post" action="{{ path('users.admin_permission_unassign') }}">
                                    <input type="hidden" name="role_id" value="{{ role.role_id }}">
                                    <input type="hidden" name="perm_id" value="{{ permission.perm_id }}">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('users.admin_permission_unassign') }}">
                                    <button type="submit" onclick="return confirm('Weet u zeker dat u deze permissie wilt verwijderen?')"
                                            class="btn btn-danger ms-2"><span class="fa fa-trash"></span></button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            {% else %}
                Nog geen permissies.
            {% endif %}
        </td>
    </tr>
    </tbody>
</table>

<h3>{{ text('LABEL_ROLE_ADD_PERMISSION') }}</h3>
<p>Een rol kan meerdere permissies hebben. Kies hieronder een gewenste permissie om toe te voegen aan de rol.</p>
{% if selectablePermissions %}
    <form method="post" action="{{ path('users.admin_permission_assign') }}">
        <input type="hidden" name="role_id" value="{{ role.role_id }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('users.admin_permission_assign') }}">
        <label class="control-label">Permission</label>
        <select name="perm_id">
            {% for permission in selectablePermissions %}
                <option value="{{ permission.perm_id }}">{{ permission.perm_id }}. {{ permission.perm_desc }}</option>
            {% endfor %}
        </select>
        <button type="submit" class="btn btn-primary ms-2">Toewijzen</button>
    </form>
{% else %}
    <p>Geen permissies om toe te wijzen</p>
{% endif %}
