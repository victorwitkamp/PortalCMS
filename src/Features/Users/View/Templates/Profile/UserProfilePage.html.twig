{% extends '@View/Layout/ApplicationLayout.html.twig' %}

{% set pageName = text('TITLE_PROFILE') ~ ' ' ~ user.user_name %}

{% block title %}{{ pageName }}{% endblock %}

{% block main_content %}
    <div class="container">
        <div class="row mt-5">
            <h1>{{ pageName }}</h1>
        </div>
        <table class="table table-striped table-condensed">
            <tr><th>ID</th><td>{{ user.user_id }}</td></tr>
            <tr><th>user_emails</th><td>{{ user.user_email }}</td></tr>
            <tr><th>user_active</th><td>{{ user.user_active }}</td></tr>
            <tr><th>user_account_type</th><td>{{ user.user_account_type }}</td></tr>
            <tr><th>user_last_login_timestamp</th><td>{{ user.user_last_login_timestamp|date('Y-m-d H:i:s') }}</td></tr>
        </table>
    </div>
{% endblock %}
