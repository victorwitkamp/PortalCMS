{% extends '@View/Layout/ApplicationLayout.html.twig' %}

{% set pageName = text('TITLE_MY_ACCOUNT') %}

{% block title %}{{ pageName }}{% endblock %}

{% block head_extra %}
    <script src="/includes/js/pass_req.js"></script>
{% endblock %}

{% block main_content %}
    <div class="container">
        <div class="row mt-5">
            <h1>{{ pageName }}</h1>
        </div>
        {% include '@View/Partials/FlashMessages.html.twig' %}
        {% include '@Users/Account/Partials/AccountDetails.html.twig' %}
        {% include '@Users/Account/Partials/ChangePasswordForm.html.twig' %}
        {% include '@Users/Account/Partials/ChangeUsernameForm.html.twig' %}
    </div>
{% endblock %}
