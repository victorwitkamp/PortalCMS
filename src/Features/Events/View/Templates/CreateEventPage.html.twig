{% extends '@View/Layout/ApplicationLayout.html.twig' %}

{% set title = pageName %}

{% block main_content %}
    <div class="container">
        <div class="row mt-5"><h1>{{ title }}</h1></div>
        <hr>
        {% include '@View/Partials/FlashMessages.html.twig' %}
        <form method="post" action="{{ path('events.create') }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('events.create') }}">
            <div class="row">
                <div class="col-sm-12">
                    <label for="eventTitle" class="control-label">{{ text('LABEL_EVENT_TITLE') }}</label>
                    <input type="text" id="eventTitle" name="title" class="form-control" required>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-6">
                    <label for="eventStart" class="control-label">{{ text('LABEL_EVENT_START') }}</label>
                    <input type="datetime-local" id="eventStart" name="start_event" class="form-control" required>
                </div>
                <div class="col-sm-6">
                    <label for="eventEnd" class="control-label">{{ text('LABEL_EVENT_END') }}</label>
                    <input type="datetime-local" id="eventEnd" name="end_event" class="form-control" required>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-12">
                    <label for="eventDesc" class="control-label">{{ text('LABEL_EVENT_DESC') }}</label>
                    <input type="text" id="eventDesc" name="description" class="form-control">
                </div>
            </div>
            <hr>
            <div class="row">
                <button type="submit" class="btn btn-primary">{{ text('LABEL_SUBMIT') }}</button>
                <a href="{{ path('events.index') }}" class="btn btn-danger">{{ text('LABEL_CANCEL') }}</a>
            </div>
        </form>
    </div>
{% endblock %}
